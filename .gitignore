dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz
.upm
tmp/
bin/
replit.md
.local
.cache
.config
data
index.d.ts

# Force-include node_modules dan .replit (override system gitignore)
!node_modules
!node_modules/**
!.replit

# Sessions — upload semua isi hisoka ke GitHub
sessions/**
!sessions/
!sessions/hisoka/
!sessions/hisoka/**

# Exclude transient runtime state files in sessions
sessions/hisoka/contacts.json
sessions/hisoka/session-*.json

# Jadibot — upload seluruh isi folder ke GitHub
!jadibot/
!jadibot/**
.token
.token.secret
.repo.last

